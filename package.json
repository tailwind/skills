{
  "name": "@tailwind-app/skills",
  "version": "0.0.2",
  "description": "Installs the Tailwind MCP server and skill playbooks into your coding agent (Claude Code, Cursor, or Codex).",
  "private": false,
  "license": "MIT",
  "bin": {
    "tailwind-app-skills": "dist/index.js"
  },
  "files": [
    "dist/**",
    "skills/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailwind/skills.git"
  },
  "homepage": "https://github.com/tailwind/skills#readme",
  "bugs": {
    "url": "https://github.com/tailwind/skills/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:dist",
    "build:dist": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run src",
    "test": "vitest run src",
    "prepublishOnly": "npm run build:dist"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.9"
  }
}
